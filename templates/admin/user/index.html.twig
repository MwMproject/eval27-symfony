{% extends 'base.html.twig' %}
{% block title %}Responsables{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between mb-4">
        <h1 class="h2">Responsables</h1>
        <a class="btn btn-primary" href="{{ path('app_admin_user_new') }}">Ajouter</a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr><th>Nom</th><th>E-mail</th><th>Rôle</th><th></th></tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ 'ROLE_ADMIN' in user.roles ? 'Administrateur' : 'Personnel' }}</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_user_edit', {id: user.id}) }}">Modifier</a></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4">Aucun responsable.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
