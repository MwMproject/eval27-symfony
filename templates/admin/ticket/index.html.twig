{% extends 'base.html.twig' %}
{% block title %}Administration des tickets{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between mb-4">
        <h1 class="h2">Administration des tickets</h1>
        <a class="btn btn-primary" href="{{ path('app_admin_ticket_new') }}">Ajouter</a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr><th>#</th><th>Auteur</th><th>Catégorie</th><th>État</th><th>Responsable</th><th></th></tr>
                </thead>
                <tbody>
                    {% for ticket in tickets %}
                        <tr>
                            <td>{{ ticket.id }}</td>
                            <td>{{ ticket.auteur }}</td>
                            <td>{{ ticket.categorie }}</td>
                            <td>{{ ticket.etat }}</td>
                            <td>{{ ticket.responsable ?: 'Non assigné' }}</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_ticket_edit', {id: ticket.id}) }}">Modifier</a></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6">Aucun ticket.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
