{% extends 'base.html.twig' %}
{% block title %}Catégories{% endblock %}
{% block body %}
    <div class="d-flex justify-content-between mb-4"><h1 class="h2">Catégories</h1><a class="btn btn-primary" href="{{ path('app_admin_categorie_new') }}">Ajouter</a></div>
    <div class="card shadow-sm"><div class="table-responsive"><table class="table mb-0">
        <thead><tr><th>Nom</th><th class="text-end">Action</th></tr></thead><tbody>
        {% for categorie in categories %}<tr><td>{{ categorie.nom }}</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_categorie_edit', {id: categorie.id}) }}">Modifier</a></td></tr>{% else %}<tr><td colspan="2">Aucune catégorie.</td></tr>{% endfor %}
        </tbody></table></div></div>
{% endblock %}
